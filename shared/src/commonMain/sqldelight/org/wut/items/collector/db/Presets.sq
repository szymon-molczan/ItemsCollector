CREATE TABLE collection_presets (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    schemaJson TEXT NOT NULL,
    isBuiltIn INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM collection_presets ORDER BY isBuiltIn DESC, name ASC;

selectById:
SELECT * FROM collection_presets WHERE id = :id;

upsert:
INSERT OR REPLACE INTO collection_presets(id, name, description, schemaJson, isBuiltIn)
VALUES (:id, :name, :description, :schemaJson, :isBuiltIn);

delete:
DELETE FROM collection_presets WHERE id = :id AND isBuiltIn = 0;
